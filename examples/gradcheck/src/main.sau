--- Gradient check: every differentiable operation in zenith, against the
--- finite-difference estimate of its own derivative.
---
--- For each parameter element the harness nudges it by ±h, re-runs the
--- forward pass, and compares the central difference
--- `(L(x+h) - L(x-h)) / 2h` against what `backward()` reported. The two
--- agreeing to five figures across twenty-odd operations is what makes the
--- autograd trustworthy — a hand-derived backward pass that is subtly
--- wrong trains to a worse answer rather than failing loudly, so this is
--- the test that has to pass.

import * from "numsol"
import * from "zenith"

class Check
  static local passed: integer = 0
  static local failed: integer = 0

  -- 1e-5: large enough that the two forward passes differ in double
  -- precision, small enough that the quadratic term stays negligible.
  static local h: float = 0.00001
  static local tolerance: float = 0.0001

  --- Compare analytic against numerical gradients for every element of
  --- every parameter. `build` must rebuild the whole graph from those
  --- parameters and return a one-element tensor.
  static fn gradients(name: string, params: table<Tensor>, build: fn() -> Tensor) -> nil
    for p: Tensor in params do
      p.zeroGrad()
    end

    local loss: Tensor = build()
    loss.backward()

    local analytic: table<NDArray> = {}

    for i: integer = 1, #params do
      analytic[i] = params[i].gradient().copy()
    end

    local worst: float = 0.0

    for i: integer = 1, #params do
      local values: NDArray = params[i].getValue()

      for k: integer = 1, values.size() do
        local original: float = values.at(k)

        values.setAt(k, original + Check.h)
        local plus: float = build().item()

        values.setAt(k, original - Check.h)
        local minus: float = build().item()

        values.setAt(k, original)

        local numeric: float = (plus - minus) / (2.0 * Check.h)
        local exact: float = analytic[i].at(k)
        local scale: float = Math.max(Math.max(Math.abs(numeric), Math.abs(exact)), 1.0)
        local relative: float = Math.abs(numeric - exact) / scale

        if relative > worst then
          worst = relative
        end
      end
    end

    if worst <= Check.tolerance then
      Check.passed = Check.passed + 1
      printf("  ok   %-26s max relative error %.2e\n", name, worst)
    else
      Check.failed = Check.failed + 1
      printf("  FAIL %-26s max relative error %.2e\n", name, worst)
    end
  end

  static fn ok(name: string, condition: boolean) -> nil
    if condition then
      Check.passed = Check.passed + 1
      println("  ok   " .. name)
    else
      Check.failed = Check.failed + 1
      println("  FAIL " .. name)
    end
  end

  static fn report() -> integer
    println("")
    println(Check.passed .. " passed, " .. Check.failed .. " failed")

    return Check.failed
  end
end

class Main
  static fn main()
    Math.randomseed(7)

    Main.binaryOps()
    Main.unaryOps()
    Main.reductions()
    Main.losses()
    Main.network()
    Main.accumulation()

    if Check.report() != 0 then
      throw "zenith gradient check failed"
    end
  end

  --- A parameter with values well away from zero, so `relu`'s kink and
  --- `log`'s pole never sit under the finite difference.
  static fn param(dims: table<integer>) -> Tensor
    return Tensor.parameter(Num.uniform(dims, 0.5, 1.5), "p")
  end

  static fn binaryOps()
    println("-- binary --")

    local a: Tensor = Main.param({2, 3})
    local b: Tensor = Main.param({2, 3})

    Check.gradients("a + b", {a, b}, () => (a + b).sum())
    Check.gradients("a - b", {a, b}, () => (a - b).sum())
    Check.gradients("a * b", {a, b}, () => (a * b).sum())
    Check.gradients("a / b", {a, b}, () => (a / b).sum())
    Check.gradients("-a", {a}, () => (-a).sum())

    -- Mixed into one expression, so the chain rule has to compose.
    Check.gradients("a * b - a / b", {a, b}, () => (a * b - a / b).sum())

    -- A row broadcast against a batch: the row's gradient must come back
    -- summed over the batch, which is `unbroadcast`'s whole job.
    local row: Tensor = Main.param({1, 3})
    Check.gradients("broadcast row", {a, row}, () => (a + row).sum())
    Check.gradients("broadcast row, mul", {a, row}, () => (a * row).sum())

    local column: Tensor = Main.param({2, 1})
    Check.gradients("broadcast column", {a, column}, () => (a + column).sum())

    local scalar: Tensor = Main.param({1})
    Check.gradients("broadcast scalar", {a, scalar}, () => (a * scalar).sum())

    local left: Tensor = Main.param({2, 3})
    local right: Tensor = Main.param({3, 4})
    Check.gradients("matmul", {left, right}, () => left.matmul(right).sum())

    -- Squared, so the gradient through matmul is not just a constant.
    Check.gradients("matmul squared", {left, right}, fn() -> Tensor
      local product: Tensor = left.matmul(right)

      return (product * product).sum()
    end)
  end

  static fn unaryOps()
    println("")
    println("-- unary --")

    local a: Tensor = Main.param({2, 3})

    -- A scalar on the right of an operator becomes a constant leaf, so
    -- these are the same graph a tensor-tensor op would build.
    Check.gradients("a * 2.5", {a}, () => (a * 2.5).sum())
    Check.gradients("a / 4.0", {a}, () => (a / 4.0).sum())
    Check.gradients("a + 3.0", {a}, () => (a + 3.0).sum())
    Check.gradients("a - 3.0", {a}, () => (a - 3.0).sum())
    Check.gradients("a ^ 2.0", {a}, () => (a ^ 2.0).sum())
    Check.gradients("a ^ 3.0", {a}, () => (a ^ 3.0).sum())
    Check.gradients("a ^ 0.5", {a}, () => (a ^ 0.5).sum())
    Check.gradients("exp", {a}, () => a.exp().sum())
    Check.gradients("log", {a}, () => a.log().sum())
    Check.gradients("sqrt", {a}, () => a.sqrt().sum())
    Check.gradients("tanh", {a}, () => a.tanh().sum())
    Check.gradients("sigmoid", {a}, () => a.sigmoid().sum())
    Check.gradients("relu, positive side", {a}, () => a.relu().sum())

    -- ReLU on inputs that straddle zero: the gate must zero the gradient
    -- on the negative half. Values are chosen to avoid landing on 0.
    local mixed: Tensor = Tensor.parameter(
      Num.array({-1.5, -0.5, 0.5, 1.5}).reshape({2, 2}), "mixed"
    )
    Check.gradients("relu, both sides", {mixed}, () => mixed.relu().sum())
    Check.gradients("leakyRelu", {mixed}, fn() -> Tensor
      local layer: LeakyReLU = LeakyReLU(0.1)

      return layer.forward(mixed).sum()
    end)

    Check.gradients("reshape", {a}, () => a.reshape({3, 2}).sum())
    Check.gradients("transpose", {a}, () => a.transpose().sum())

    -- Transpose then matmul: the shapes only line up if transpose really
    -- moved the elements, and the gradient only lines up if it moves back.
    Check.gradients("transpose into matmul", {a}, fn() -> Tensor
      return a.transpose().matmul(a).sum()
    end)
  end

  static fn reductions()
    println("")
    println("-- reductions --")

    local a: Tensor = Main.param({3, 4})

    Check.gradients("sum", {a}, () => a.sum())
    Check.gradients("mean", {a}, () => a.mean())
    Check.gradients("sum of squares", {a}, () => (a * a).sum())

    Check.gradients("sumAxis(1)", {a}, () => a.sumAxis(1).sum())
    Check.gradients("sumAxis(2)", {a}, () => a.sumAxis(2).sum())
    Check.gradients("sumAxis keepDims", {a}, () => a.sumAxis(1, true).sum())
    Check.gradients("meanAxis(1)", {a}, () => a.meanAxis(1).sum())
    Check.gradients("meanAxis(2)", {a}, () => a.meanAxis(2).sum())

    -- Weighted, so each collapsed position carries a different gradient.
    local weights: Tensor = Main.param({4})
    Check.gradients("weighted sumAxis", {a, weights}, fn() -> Tensor
      return (a.sumAxis(1) * weights).sum()
    end)

    -- Softmax: rows sum to 1, so a plain `.sum()` would be constant and
    -- hide every mistake. Weighting it gives the gradient something to say.
    local probabilities: Tensor = Main.param({2, 3})
    local weighting: Tensor = Main.param({2, 3})
    Check.gradients("softmax", {probabilities}, fn() -> Tensor
      return (probabilities.softmax(2) * weighting).sum()
    end)

    Check.gradients("softmax, log of", {probabilities}, fn() -> Tensor
      return (probabilities.softmax(2).log() * weighting).sum()
    end)
  end

  static fn losses()
    println("")
    println("-- losses --")

    local pred: Tensor = Main.param({3, 2})
    local target: Tensor = Tensor.constant(Num.uniform({3, 2}, 0.0, 1.0))

    Check.gradients("mse", {pred}, () => Loss.mse(pred, target))
    Check.gradients("mae", {pred}, () => Loss.mae(pred, target))

    local logits: Tensor = Main.param({4, 3})
    local classes: table<integer> = {1, 3, 2, 3}

    Check.gradients("crossEntropy", {logits}, fn() -> Tensor
      return Loss.crossEntropy(logits, classes)
    end)

    -- The fused loss must agree with the composed one it stands in for.
    local composed: float = Loss.crossEntropy(logits, classes).item()
    local byHand: float = 0.0
    local probs: NDArray = logits.softmax(2).getValue()

    for b: integer = 1, #classes do
      byHand = byHand - Math.log(probs.get({b, classes[b]}))
    end

    local rows: integer = #classes
    byHand = byHand / (rows as float)
    Check.ok("crossEntropy matches softmax + log", Math.abs(composed - byHand) < 0.000001)

    local binary: Tensor = Main.param({4, 1})
    local truths: Tensor = Tensor.constant(Num.matrix({{1.0}, {0.0}, {1.0}, {0.0}}))

    Check.gradients("bceWithLogits", {binary}, fn() -> Tensor
      return Loss.bceWithLogits(binary, truths)
    end)
  end

  static fn network()
    println("")
    println("-- a whole network --")

    local x: Tensor = Tensor.constant(Num.uniform({5, 3}, -1.0, 1.0))
    local y: Tensor = Tensor.constant(Num.uniform({5, 2}, -1.0, 1.0))

    local net: Sequential = Sequential({
      Linear(3, 6), Tanh(), Linear(6, 4), ReLU(), Linear(4, 2)
    })

    Check.gradients("3-layer net, mse", net.parameters(), fn() -> Tensor
      return Loss.mse(net.forward(x), y)
    end)

    local classifier: Sequential = Sequential({
      Linear(3, 8), Tanh(), Linear(8, 4)
    })
    local labels: table<integer> = {1, 2, 3, 4, 2}

    Check.gradients("classifier, crossEntropy", classifier.parameters(), fn() -> Tensor
      return Loss.crossEntropy(classifier.forward(x), labels)
    end)

    -- A parameter reaching the loss down two separate paths: its gradient
    -- is the sum of both, which is what the topological walk is for.
    local shared: Tensor = Main.param({2, 2})

    Check.gradients("diamond graph", {shared}, fn() -> Tensor
      local leftBranch: Tensor = shared.tanh()
      local rightBranch: Tensor = shared.exp()

      return (leftBranch * rightBranch + shared).sum()
    end)

    Check.gradients("deep chain", {shared}, fn() -> Tensor
      local current: Tensor = shared

      for i: integer = 1, 6 do
        current = current.tanh() + 0.1
      end

      return current.sum()
    end)
  end

  static fn accumulation()
    println("")
    println("-- accumulation --")

    local p: Tensor = Tensor.parameter(Num.matrix({{2.0, 3.0}}), "p")

    p.zeroGrad()
    p.sum().backward()
    local once: float = p.gradient().at(1)

    -- A second backward pass without zeroGrad must *add* to the gradient,
    -- the same contract PyTorch has. This is why optimisers clear first.
    p.sum().backward()
    local twice: float = p.gradient().at(1)

    Check.ok("gradients accumulate across backward passes", once == 1.0 and twice == 2.0)

    p.zeroGrad()
    Check.ok("zeroGrad clears", p.gradient().at(1) == 0.0)

    -- A constant leaf collects nothing, so frozen inputs cost nothing.
    local frozen: Tensor = Tensor.constant(Num.matrix({{1.0, 1.0}}))
    local live: Tensor = Tensor.parameter(Num.matrix({{1.0, 1.0}}), "live")

    -- Bound to a local because a statement opening with `(` would read as
    -- a call on the line above.
    local mixedProduct: Tensor = frozen * live
    mixedProduct.sum().backward()

    Check.ok("constants take no gradient", not frozen.hasGradient())
    Check.ok("parameters do", live.hasGradient())

    local cut: Tensor = live.detach()
    Check.ok("detach returns a plain leaf", not cut.requiresGrad())
  end
end
